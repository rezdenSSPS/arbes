using System.IO;
using UnityEditor;
using UnityEditor.Events;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.Events;
using UnityEngine.EventSystems;
using UnityEngine.InputSystem.UI;
using UnityEngine.SceneManagement;
using UnityEngine.UI;

/// <summary>
/// Builds the MainMenu and Game scenes (player, level, camera, UI) and adds them to Build Settings.
/// Runs automatically once if the scenes don't exist yet; re-run via Tools > Arbes.
/// </summary>
[InitializeOnLoad]
public static class ArbesSceneBuilder
{
    const string MenuScenePath = "Assets/Scenes/MainMenu.unity";
    const string GameScenePath = "Assets/Scenes/Game.unity";
    const string MaterialsFolder = "Assets/Materials";

    static readonly Color Accent = new Color(1f, 0.55f, 0.15f);
    static readonly Color ButtonNormal = new Color(0.15f, 0.17f, 0.23f, 0.95f);
    static readonly Color Dark = new Color(0.07f, 0.08f, 0.11f);

    static ArbesSceneBuilder()
    {
        if (File.Exists(MenuScenePath) && File.Exists(GameScenePath)) return;
        if (SessionState.GetBool("Arbes.AutoBuildDone", false)) return;
        SessionState.SetBool("Arbes.AutoBuildDone", true);
        EditorApplication.delayCall += () =>
        {
            if (EditorApplication.isPlayingOrWillChangePlaymode) return;
            Build();
        };
    }

    [MenuItem("Tools/Arbes/Rebuild Menu + Game Scenes")]
    static void RebuildFromMenu()
    {
        if (File.Exists(MenuScenePath) || File.Exists(GameScenePath))
        {
            if (!EditorUtility.DisplayDialog("Rebuild scenes?",
                    "This overwrites Assets/Scenes/MainMenu.unity and Assets/Scenes/Game.unity.", "Rebuild", "Cancel"))
                return;
        }
        Build();
    }

    public static void Build()
    {
        if (!EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo()) return;

        if (!AssetDatabase.IsValidFolder(MaterialsFolder))
            AssetDatabase.CreateFolder("Assets", "Materials");

        BuildGameScene();
        BuildMenuScene();

        EditorBuildSettings.scenes = new[]
        {
            new EditorBuildSettingsScene(MenuScenePath, true),
            new EditorBuildSettingsScene(GameScenePath, true),
        };

        AssetDatabase.SaveAssets();
        EditorSceneManager.OpenScene(MenuScenePath);
        Debug.Log("[Arbes] Built MainMenu + Game scenes and added them to Build Settings. Press Play in MainMenu to start.");
    }

    // ---------------------------------------------------------------- Game scene

    static void BuildGameScene()
    {
        Scene scene = EditorSceneManager.NewScene(NewSceneSetup.DefaultGameObjects, NewSceneMode.Single);

        Material groundMat = GetMaterial("Ground", new Color(0.36f, 0.45f, 0.36f));
        Material blockMat = GetMaterial("Block", new Color(0.35f, 0.47f, 0.7f));
        Material playerMat = GetMaterial("Player", Accent);
        Material visorMat = GetMaterial("Visor", new Color(0.1f, 0.1f, 0.12f));

        // Level
        var level = new GameObject("Level");
        var ground = GameObject.CreatePrimitive(PrimitiveType.Plane);
        ground.name = "Ground";
        ground.transform.SetParent(level.transform);
        ground.transform.localScale = new Vector3(6f, 1f, 6f); // 60 x 60 m
        ground.GetComponent<Renderer>().sharedMaterial = groundMat;

        AddBlock(level, "Crate", new Vector3(4f, 0.5f, 5f), Vector3.one, Vector3.zero, blockMat);
        AddBlock(level, "Big Crate", new Vector3(-5f, 0.75f, 4f), Vector3.one * 1.5f, new Vector3(0f, 20f, 0f), blockMat);
        AddBlock(level, "Wall", new Vector3(0f, 1f, 14f), new Vector3(12f, 2f, 1f), Vector3.zero, blockMat);
        AddBlock(level, "Step 1", new Vector3(-9f, 0.5f, -6f), new Vector3(3f, 1f, 3f), Vector3.zero, blockMat);
        AddBlock(level, "Step 2", new Vector3(-9f, 1f, -9f), new Vector3(3f, 2f, 3f), Vector3.zero, blockMat);
        AddBlock(level, "Step 3", new Vector3(-9f, 1.5f, -12f), new Vector3(3f, 3f, 3f), Vector3.zero, blockMat);
        AddBlock(level, "Ramp", new Vector3(9f, 1f, -6f), new Vector3(3f, 0.3f, 8f), new Vector3(-15f, 0f, 0f), blockMat);
        AddBlock(level, "Ramp Top", new Vector3(9f, 1f, -13f), new Vector3(3f, 2f, 6f), Vector3.zero, blockMat);

        // Player
        var player = new GameObject("Player");
        player.tag = "Player";
        player.transform.position = new Vector3(0f, 1.05f, 0f);
        var cc = player.AddComponent<CharacterController>();
        cc.height = 2f;
        cc.radius = 0.5f;
        cc.center = Vector3.zero;

        var body = GameObject.CreatePrimitive(PrimitiveType.Capsule);
        body.name = "Body";
        body.transform.SetParent(player.transform, false);
        Object.DestroyImmediate(body.GetComponent<Collider>());
        body.GetComponent<Renderer>().sharedMaterial = playerMat;

        var visor = GameObject.CreatePrimitive(PrimitiveType.Cube);
        visor.name = "Visor (shows facing)";
        visor.transform.SetParent(player.transform, false);
        visor.transform.localPosition = new Vector3(0f, 0.5f, 0.4f);
        visor.transform.localScale = new Vector3(0.7f, 0.25f, 0.3f);
        Object.DestroyImmediate(visor.GetComponent<Collider>());
        visor.GetComponent<Renderer>().sharedMaterial = visorMat;

        // Camera
        Camera cam = Camera.main;
        if (cam == null) cam = Object.FindAnyObjectByType<Camera>();
        var follow = cam.gameObject.AddComponent<ThirdPersonCamera>();
        follow.target = player.transform;
        cam.transform.position = new Vector3(0f, 4f, -6f);
        cam.transform.LookAt(player.transform);

        var controller = player.AddComponent<PlayerController>();
        controller.cameraTransform = cam.transform;

        // UI: HUD + pause menu
        Canvas canvas = CreateCanvas("Game UI");

        Text hint = CreateText(canvas.transform, "Controls Hint",
            "WASD move  ·  Shift sprint  ·  Space jump  ·  Mouse look  ·  Esc pause", 26, TextAnchor.UpperLeft, new Color(1f, 1f, 1f, 0.85f));
        var hintRt = hint.rectTransform;
        hintRt.anchorMin = hintRt.anchorMax = hintRt.pivot = new Vector2(0f, 1f);
        hintRt.anchoredPosition = new Vector2(30f, -24f);
        hintRt.sizeDelta = new Vector2(1200f, 40f);
        hint.gameObject.AddComponent<Shadow>().effectColor = new Color(0f, 0f, 0f, 0.6f);

        RectTransform pausePanel = CreateRect("Pause Panel", canvas.transform);
        Stretch(pausePanel);
        pausePanel.gameObject.AddComponent<Image>().color = new Color(0f, 0f, 0f, 0.65f);

        Text pauseTitle = CreateText(pausePanel, "Title", "PAUSED", 90, TextAnchor.MiddleCenter, Color.white);
        pauseTitle.fontStyle = FontStyle.Bold;
        pauseTitle.rectTransform.anchoredPosition = new Vector2(0f, 230f);
        pauseTitle.rectTransform.sizeDelta = new Vector2(800f, 120f);

        var pauseMenu = canvas.gameObject.AddComponent<PauseMenu>();
        RectTransform pauseButtons = CreateButtonColumn(pausePanel, new Vector2(0f, -40f));
        Button resume = CreateButton(pauseButtons, "Resume", pauseMenu.Resume);
        CreateButton(pauseButtons, "Main Menu", pauseMenu.LoadMainMenu);
        CreateButton(pauseButtons, "Quit", pauseMenu.Quit);

        pauseMenu.pausePanel = pausePanel.gameObject;
        pauseMenu.firstSelected = resume.gameObject;
        pausePanel.gameObject.SetActive(false);

        CreateEventSystem(null);

        EditorSceneManager.SaveScene(scene, GameScenePath);
    }

    static void AddBlock(GameObject parent, string name, Vector3 pos, Vector3 scale, Vector3 euler, Material mat)
    {
        var block = GameObject.CreatePrimitive(PrimitiveType.Cube);
        block.name = name;
        block.transform.SetParent(parent.transform);
        block.transform.SetPositionAndRotation(pos, Quaternion.Euler(euler));
        block.transform.localScale = scale;
        block.GetComponent<Renderer>().sharedMaterial = mat;
        block.isStatic = true;
    }

    // ---------------------------------------------------------------- Menu scene

    static void BuildMenuScene()
    {
        Scene scene = EditorSceneManager.NewScene(NewSceneSetup.DefaultGameObjects, NewSceneMode.Single);

        Camera cam = Camera.main;
        if (cam == null) cam = Object.FindAnyObjectByType<Camera>();
        cam.clearFlags = CameraClearFlags.SolidColor;
        cam.backgroundColor = Dark;

        Canvas canvas = CreateCanvas("Menu UI");
        var menu = canvas.gameObject.AddComponent<MainMenu>();

        RectTransform bg = CreateRect("Background", canvas.transform);
        Stretch(bg);
        bg.gameObject.AddComponent<Image>().color = Dark;

        RectTransform stripe = CreateRect("Accent Stripe", canvas.transform);
        stripe.anchorMin = new Vector2(0f, 0f);
        stripe.anchorMax = new Vector2(0f, 1f);
        stripe.pivot = new Vector2(0f, 0.5f);
        stripe.sizeDelta = new Vector2(14f, 0f);
        stripe.gameObject.AddComponent<Image>().color = Accent;

        // Main panel
        RectTransform mainPanel = CreateRect("Main Panel", canvas.transform);
        Stretch(mainPanel);

        Text title = CreateText(mainPanel, "Title", "ARBES", 160, TextAnchor.MiddleCenter, Color.white);
        title.fontStyle = FontStyle.Bold;
        title.rectTransform.anchoredPosition = new Vector2(0f, 250f);
        title.rectTransform.sizeDelta = new Vector2(1200f, 200f);

        Text subtitle = CreateText(mainPanel, "Subtitle", "a small adventure", 34, TextAnchor.MiddleCenter, Accent);
        subtitle.rectTransform.anchoredPosition = new Vector2(0f, 140f);
        subtitle.rectTransform.sizeDelta = new Vector2(1200f, 50f);

        RectTransform mainButtons = CreateButtonColumn(mainPanel, new Vector2(0f, -110f));
        Button start = CreateButton(mainButtons, "Start Game", menu.StartGame);
        CreateButton(mainButtons, "Controls", menu.ShowControls);
        CreateButton(mainButtons, "Quit", menu.Quit);

        // Controls panel
        RectTransform controlsPanel = CreateRect("Controls Panel", canvas.transform);
        Stretch(controlsPanel);

        Text controlsTitle = CreateText(controlsPanel, "Title", "CONTROLS", 90, TextAnchor.MiddleCenter, Color.white);
        controlsTitle.fontStyle = FontStyle.Bold;
        controlsTitle.rectTransform.anchoredPosition = new Vector2(0f, 300f);
        controlsTitle.rectTransform.sizeDelta = new Vector2(1000f, 120f);

        Text controlsBody = CreateText(controlsPanel, "Body",
            "Move  —  W A S D  /  Arrow keys  /  Left stick\n" +
            "Look  —  Mouse  /  Right stick\n" +
            "Sprint  —  Left Shift  /  L3\n" +
            "Jump  —  Space  /  A (Cross)\n" +
            "Pause  —  Esc  /  Start",
            36, TextAnchor.MiddleCenter, new Color(0.85f, 0.87f, 0.92f));
        controlsBody.lineSpacing = 1.3f;
        controlsBody.rectTransform.anchoredPosition = new Vector2(0f, 40f);
        controlsBody.rectTransform.sizeDelta = new Vector2(1100f, 340f);

        RectTransform backColumn = CreateButtonColumn(controlsPanel, new Vector2(0f, -260f));
        Button back = CreateButton(backColumn, "Back", menu.ShowMain);
        controlsPanel.gameObject.SetActive(false);

        menu.mainPanel = mainPanel.gameObject;
        menu.controlsPanel = controlsPanel.gameObject;
        menu.mainFirstSelected = start.gameObject;
        menu.controlsFirstSelected = back.gameObject;

        CreateEventSystem(start.gameObject);

        EditorSceneManager.SaveScene(scene, MenuScenePath);
    }

    // ---------------------------------------------------------------- Helpers

    static Material GetMaterial(string name, Color color)
    {
        string path = $"{MaterialsFolder}/{name}.mat";
        var mat = AssetDatabase.LoadAssetAtPath<Material>(path);
        if (mat == null)
        {
            Shader shader = Shader.Find("Universal Render Pipeline/Lit");
            if (shader == null) shader = Shader.Find("Standard");
            mat = new Material(shader);
            AssetDatabase.CreateAsset(mat, path);
        }
        mat.color = color;
        if (mat.HasProperty("_BaseColor")) mat.SetColor("_BaseColor", color);
        EditorUtility.SetDirty(mat);
        return mat;
    }

    static Font UIFont => Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");

    static Canvas CreateCanvas(string name)
    {
        var go = new GameObject(name, typeof(RectTransform), typeof(Canvas), typeof(CanvasScaler), typeof(GraphicRaycaster));
        var canvas = go.GetComponent<Canvas>();
        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
        var scaler = go.GetComponent<CanvasScaler>();
        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(1920f, 1080f);
        scaler.matchWidthOrHeight = 0.5f;
        return canvas;
    }

    static void CreateEventSystem(GameObject firstSelected)
    {
        var go = new GameObject("EventSystem", typeof(EventSystem), typeof(InputSystemUIInputModule));
        go.GetComponent<InputSystemUIInputModule>().AssignDefaultActions();
        if (firstSelected != null) go.GetComponent<EventSystem>().firstSelectedGameObject = firstSelected;
    }

    static RectTransform CreateRect(string name, Transform parent)
    {
        var go = new GameObject(name, typeof(RectTransform));
        go.layer = LayerMask.NameToLayer("UI");
        go.transform.SetParent(parent, false);
        return (RectTransform)go.transform;
    }

    static void Stretch(RectTransform rt)
    {
        rt.anchorMin = Vector2.zero;
        rt.anchorMax = Vector2.one;
        rt.offsetMin = Vector2.zero;
        rt.offsetMax = Vector2.zero;
    }

    static Text CreateText(Transform parent, string name, string content, int size, TextAnchor anchor, Color color)
    {
        RectTransform rt = CreateRect(name, parent);
        var text = rt.gameObject.AddComponent<Text>();
        text.font = UIFont;
        text.text = content;
        text.fontSize = size;
        text.alignment = anchor;
        text.color = color;
        text.horizontalOverflow = HorizontalWrapMode.Wrap;
        text.verticalOverflow = VerticalWrapMode.Overflow;
        text.raycastTarget = false;
        return text;
    }

    static RectTransform CreateButtonColumn(Transform parent, Vector2 position)
    {
        RectTransform column = CreateRect("Buttons", parent);
        column.anchoredPosition = position;
        column.sizeDelta = new Vector2(420f, 300f);
        var layout = column.gameObject.AddComponent<VerticalLayoutGroup>();
        layout.childAlignment = TextAnchor.UpperCenter;
        layout.spacing = 18f;
        layout.childControlWidth = true;
        layout.childControlHeight = true;
        layout.childForceExpandWidth = false;
        layout.childForceExpandHeight = false;
        return column;
    }

    static Button CreateButton(Transform parent, string label, UnityAction onClick)
    {
        RectTransform rt = CreateRect(label + " Button", parent);
        var image = rt.gameObject.AddComponent<Image>();
        image.color = Color.white;

        var button = rt.gameObject.AddComponent<Button>();
        ColorBlock colors = button.colors;
        colors.normalColor = ButtonNormal;
        colors.highlightedColor = Accent;
        colors.selectedColor = Accent;
        colors.pressedColor = Accent * 0.8f;
        colors.disabledColor = new Color(0.3f, 0.3f, 0.3f, 0.5f);
        colors.fadeDuration = 0.08f;
        button.colors = colors;

        var element = rt.gameObject.AddComponent<LayoutElement>();
        element.preferredWidth = 420f;
        element.preferredHeight = 76f;

        Text text = CreateText(rt, "Label", label.ToUpperInvariant(), 30, TextAnchor.MiddleCenter, Color.white);
        text.fontStyle = FontStyle.Bold;
        Stretch(text.rectTransform);

        UnityEventTools.AddPersistentListener(button.onClick, onClick);
        return button;
    }
}
